{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "app.config.js"],
  "exclude": ["node_modules", "android", "ios", "dist", "tests"]
}
