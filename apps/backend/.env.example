# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=greenalert
DB_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
DB_NAME=green-alert

# JWT Configuration
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=7
OAUTH_CALLBACK_CODE_TTL_SECONDS=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PASSWORD_RESET_MAX=5

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary Configuration
# Opcional para iniciar la app y correr tests. Requerido solo al subir/eliminar archivos en Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=green-alert/reportes
CLOUDINARY_AVATAR_FOLDER=green-alert/usuarios

# Email Configuration
APP_NAME=GreenAlert
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=greenalert@example.test
EMAIL_TEST_TO=tu_correo@gmail.com

# SMTP aliases
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=GreenAlert <tu_correo@gmail.com>

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth Configuration
# Ver: GOOGLE_OAUTH_SETUP.md para obtener estas credenciales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook OAuth Configuration
# Ver README.md para obtener estas credenciales
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_CALLBACK_RESPONSE=json

# OpenID Connect con Microsoft Entra ID (segundo proveedor externo). Registrar la app en
# https://entra.microsoft.com → App registrations; URI de redirección web = MICROSOFT_REDIRECT_URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://localhost:8443/api/auth/microsoft/callback

# API Configuration
API_PREFIX=/api
API_PUBLIC_URL=http://localhost:3000

# Hugging Face API
# Token con scope "Inference Providers" en https://huggingface.co/settings/tokens
HF_API_KEY=
# Modelo VLM usado via HF Router. Default: zai-org/GLM-4.5V
HF_IMAGE_MODEL=zai-org/GLM-4.5V

# Evidence scoring
# Maximo de horas para considerar reciente la metadata EXIF de una evidencia
EXIF_MAX_HORAS=72

# Chatbot NLP - Groq
GROQ_API_KEY=
# Opciones: llama-3.1-8b-instant, llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Chatbot NLP - Gemini fallback
GEMINI_API_KEY=
# Opciones: gemini-2.0-flash-exp, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-exp

# Firebase Admin SDK
# Obtener de Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa opcional: JSON completo del service account en una sola variable
FIREBASE_SERVICE_ACCOUNT_JSON=

# Desarrollo local: no envia correos reales.
EMAIL_TRANSPORT=json
DB_SSL=false
