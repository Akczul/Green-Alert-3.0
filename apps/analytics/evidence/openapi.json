  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "status": {
            "type": "string",
            "const": "error",
            "title": "Status",
            "default": "error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "message",
          "code"
        ],
        "title": "ErrorEnvelope"
      },
      "Evaluation": {
        "properties": {
          "mae": {
            "type": "number",
            "title": "Mae"
          },
          "rmse": {
            "type": "number",
            "title": "Rmse"
          },
          "r2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "R2"
          },
          "baseline_lag1_mae": {
            "type": "number",
            "title": "Baseline Lag1 Mae"
          },
          "train_samples": {
            "type": "integer",
            "title": "Train Samples"
          },
          "test_samples": {
            "type": "integer",
            "title": "Test Samples"
          },
          "train_through": {
            "type": "string",
            "title": "Train Through"
          },
          "test_from": {
            "type": "string",
            "title": "Test From"
          },
          "test_through": {
            "type": "string",
            "title": "Test Through"
          },
          "protocol": {
            "type": "string",
            "const": "temporal_holdout_one_step_observed_lags",
            "title": "Protocol"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mae",
          "rmse",
          "r2",
          "baseline_lag1_mae",
          "train_samples",
          "test_samples",
          "train_through",
          "test_from",
          "test_through",
          "protocol"
        ],
        "title": "Evaluation"
      },
      "ForecastRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "source_revision": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Source Revision"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "mysql",
              "synthetic"
            ],
            "title": "Source Kind"
          },
          "model_id": {
            "type": "string",
            "format": "uuid",
            "title": "Model Id"
          },
          "histories": {
            "items": {
              "$ref": "#/components/schemas/ZoneHistory"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Histories"
          },
          "horizon_weeks": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Horizon Weeks",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
