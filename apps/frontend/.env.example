# Frontend Environment Variables

# Vite Build
# El cliente utiliza /api; VITE_API_URL no es consumida por src/services/api.js.
VITE_APP_NAME=GreenAlert
VITE_APP_VERSION=2.0.0

# Development/Production
VITE_ENV=development

# Feature Flags (optional)
VITE_ENABLE_MAPS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_IA_FEATURES=false

# External Services (optional)
VITE_GOOGLE_CLIENT_ID=
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# FE-30: Firebase Cloud Messaging (Push Notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
