# Solo infraestructura local. npm run setup genera valores aleatorios en .env.
MYSQL_DATABASE=green-alert
MYSQL_USER=greenalert
MYSQL_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
MYSQL_ROOT_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
MYSQL_PORT=3307
FRONTEND_PORT=8080

# Configuracion publica opcional para el build Docker (solo valores VITE_*).
# Para npm run dev, configurar los mismos campos en apps/frontend/.env.
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
